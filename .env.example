# BikerZone - Configuracion
# Copia a .env y rellena los valores. NO comitees tu .env real.

# Puerto de la app
PORT=8000

# Base de datos
DB_NAME=bikerzone
DB_USER=bikerzone_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave secreta para sesiones JWT (OBLIGATORIO en produccion)
# Genera una aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin inicial (se crea solo la primera vez)
ADMIN_EMAIL=admin@bikerzone.com
ADMIN_PASSWORD=

# Entorno: development | production
ENVIRONMENT=development

# Moneda
# Simbolo: $, €, £, ¥, Q, etc.
CURRENCY_SYMBOL=Q
# Codigo ISO: USD, EUR, GBP, JPY, MXN, GTQ, etc.
CURRENCY_CODE=GTQ
# Decimales: 2 para USD/EUR/GTQ, 0 para JPY
CURRENCY_DECIMALS=2

# Notificaciones - Email (SMTP). Si se dejan vacios, el envio automatico se omite.
# Ejemplo Gmail: host smtp.gmail.com, puerto 587, usuario runemalops@gmail.com
# y SMTP_PASSWORD = App Password de 16 digitos (no la contrasena de Google).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente mostrado en el correo (ej: BikerZone <runemalops@gmail.com>)
SMTP_FROM=
SMTP_USE_TLS=true

# Notificaciones - Telegram Bot (obtener token de @BotFather).
# El cliente debe iniciar chat con el bot y su chat_id se guarda en su perfil.
TELEGRAM_BOT_TOKEN=

# IVA (0.12 = 12%)
IVA_RATE=0.12
