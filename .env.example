# BikerZone - Configuracion
# Copia a .env y rellena los valores. NO comitees tu .env real.

# Puerto de la app
PORT=8000

# Base de datos
DB_NAME=bikerzone
DB_USER=bikerzone_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave secreta para sesiones JWT (OBLIGATORIO en produccion)
# Genera una aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin inicial (se crea solo la primera vez)
ADMIN_EMAIL=admin@bikerzone.com
ADMIN_PASSWORD=

# Entorno: development | production
ENVIRONMENT=development

# Moneda
# Simbolo: $, €, £, ¥, Q, etc.
CURRENCY_SYMBOL=Q
# Codigo ISO: USD, EUR, GBP, JPY, MXN, GTQ, etc.
CURRENCY_CODE=GTQ
# Decimales: 2 para USD/EUR/GTQ, 0 para JPY
CURRENCY_DECIMALS=2
